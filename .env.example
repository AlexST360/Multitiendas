APP_NAME=Multitiendas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de datos — MySQL
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multora
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Cola de trabajos (envío de emails, etc.)
# Correr el worker con: php artisan queue:work --tries=3
QUEUE_CONNECTION=database

CACHE_STORE=database

# -----------------------------------------------------------------------------
# Email — Resend (recomendado para producción)
# Crear cuenta en resend.com, obtener API key y dominio verificado
# -----------------------------------------------------------------------------
MAIL_MAILER=log
# MAIL_MAILER=resend              # producción
MAIL_FROM_ADDRESS="noreply@tudominio.cl"
MAIL_FROM_NAME="${APP_NAME}"

# Credenciales Resend (producción)
# RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Alternativa SMTP genérico
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=tu@email.cl
# MAIL_PASSWORD=tu_password
# MAIL_SCHEME=tls

# -----------------------------------------------------------------------------
# Webpay Plus — Transbank
# Docs: https://www.transbankdevelopers.cl
# Integración sandbox usa las credenciales por defecto (no cambiar para pruebas)
# -----------------------------------------------------------------------------
TRANSBANK_ENV=integration
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# Producción:
# TRANSBANK_ENV=production
# TRANSBANK_COMMERCE_CODE=tu_codigo_de_comercio
# TRANSBANK_API_KEY=tu_api_key

# -----------------------------------------------------------------------------
# MercadoPago Checkout Pro
# Docs: https://www.mercadopago.cl/developers
# Obtener access token en: Panel MP → Credenciales → Sandbox
# -----------------------------------------------------------------------------
MP_ENV=sandbox
MP_ACCESS_TOKEN=

# Producción:
# MP_ENV=production
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx

VITE_APP_NAME="${APP_NAME}"
